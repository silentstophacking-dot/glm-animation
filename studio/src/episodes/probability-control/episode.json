{
  "id": "ProbabilityControl",
  "slug": "probability-control",
  "topic": "What if you could control probability?",
  "title": [
    "WHAT IF YOU COULD",
    "CONTROL PROBABILITY?"
  ],
  "fps": 30,
  "end": "f:1170",
  "script": [
    {
      "beat": "1 cold open / the consequence",
      "text": "He made his chance of dying zero. Big mistake."
    },
    {
      "beat": "2 the premise and the first demonstration",
      "text": "What if you could control probability? A coin flip? Always heads."
    },
    {
      "beat": "3 fun / escalating win",
      "text": "Winning the lottery? Every single time."
    },
    {
      "beat": "4 rule and an attempt to cheat",
      "text": "But here's the catch. Only one probability can change at once. So he makes dying impossible."
    },
    {
      "beat": "5 disaster, nobody powerful notices: the environment attacks",
      "text": "That night, he walks home. Suddenly, the street gives way. He drops straight into darkness. Buried under concrete. Still alive."
    },
    {
      "beat": "6 moral choice: escape versus guaranteed survival",
      "text": "His chance of escaping? One percent. He changes it to one hundred. His protection disappears. The rubble begins to move. It launches him into the street."
    },
    {
      "beat": "7 dark payoff (freeze before collision)",
      "text": "Right into an oncoming truck. He guaranteed his escape. Not his survival."
    }
  ],
  "science": [
    {
      "claim": "A 1% probability represents one outcome per 100 equally likely possibilities in this illustrative diagram.",
      "working": "1% = 1/100 = 0.01. This is a mathematical definition, not a predictive guarantee or a claim that probabilities can be controlled.",
      "source": "OpenStax Introductory Statistics 2e, Probability Topics (probabilities from 0 to 1)"
    }
  ],
  "story_rule": "Only one event's chance may be set at once. The next edit overwrites the previous setting.",
